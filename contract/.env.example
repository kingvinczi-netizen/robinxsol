# Copy this file to .env and fill in real values. NEVER commit .env.

# RPC endpoint for the Sepolia testnet (Infura, Alchemy, or a public RPC).
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# RPC endpoint for Base mainnet. The public one below works for deploys.
BASE_RPC_URL=https://mainnet.base.org

# Private key of the FRESH, dedicated deployer wallet (test funds only until mainnet).
# Never use a personal wallet that holds real assets. With or without the 0x prefix.
PRIVATE_KEY=your_deployer_private_key

# Etherscan v2 API key — a single key verifies on both Etherscan (Sepolia) and Basescan (Base).
ETHERSCAN_API_KEY=your_etherscan_v2_api_key
