# Copy this file to .env.local and fill in real values. NEVER commit .env.local.

# WalletConnect project id from https://cloud.reown.com (free). Required for wallet connect.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Deployed ROBINXSOL contract address on each network.
# Fill Sepolia first (Stage 1), then Base after the real launch (Stage 2).
NEXT_PUBLIC_RXS_ADDRESS_SEPOLIA=0xYourSepoliaContractAddress
NEXT_PUBLIC_RXS_ADDRESS_BASE=0xYourBaseContractAddress
